# ==========================================
# BERKAYTUR SERVIS OTOMASYONU - ENVIRONMENT VARIABLES
# ==========================================

# 1. SERVER & RUNTIME ENVIRONMENT CONFIGURATION
PORT=3000
NODE_ENV=production
APP_URL=https://berkaytur.onrender.com
ALLOWED_ORIGINS=https://berkaytur.onrender.com

# 2. DATABASE CONFIGURATION (Neon PostgreSQL / Render Managed Postgres)
# PostgreSQL connection string for Prisma ORM
DATABASE_URL=postgresql://user:password@ep-cool-db-123456.eu-central-1.aws.neon.tech/neondb?sslmode=require

# 3. JWT AUTHENTICATION SECURITY KEYS (Min 32 random characters)
JWT_SECRET=YOUR_PRODUCTION_JWT_SECRET_KEY_HERE_MIN_32_CHARS
JWT_REFRESH_SECRET=YOUR_PRODUCTION_JWT_REFRESH_SECRET_KEY_HERE_MIN_32_CHARS

# 4. ADMIN INITIAL CREDENTIALS (Auto-provisioned on startup)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD

# 5. GOOGLE AI STUDIO / GEMINI API INTEGRATION (Optional - Fallback active if empty)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# 6. GOOGLE SHEETS & DRIVE INTEGRATION (Optional)
GOOGLE_APPS_SCRIPT_URL=
APPS_SCRIPT_SECRET=

# 7. WHATSAPP WEB GATEWAY INTEGRATION (Optional)
WHATSAPP_GATEWAY_URL=
WHATSAPP_API_KEY=





